# MySQL ConfigMap and Secret Template
# Copy this file to mysql-config.yaml and replace the placeholder values

apiVersion: v1
kind: ConfigMap
metadata:
  name: mysql-config
data:
  database: "demo_db"
  host: "mysql-service"
  port: "3306"
---
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
type: Opaque
stringData:
  root-password: "CHANGE_ME"  # ⚠️ Change this to a secure password
  username: "root"
  password: "CHANGE_ME"       # ⚠️ Change this to a secure password

